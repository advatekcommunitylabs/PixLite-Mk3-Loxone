				<C Type="Code16" V="178" U="8d1a443e-6736-487d-a5e5714b832aa8c1" Title="PixLite telemetry, enable after commissioning" Px="3648" Py="2976" Px2="6336" Py2="3864" Cl="141,255,112" Nio="34" Code="



#define PX_BYTES 4096
#define PX_TOKENS 256
#define PX_PORTS 32
#define PX_BANKS 8
char *px_json;
int px_pos, px_len, px_count;
int px_start[PX_TOKENS], px_end[PX_TOKENS], px_next[PX_TOKENS], px_type[PX_TOKENS];
int px_ports, px_banks, px_power, px_temp_valid;
float px_temp, px_volts[PX_BANKS];
int px_bank_valid[PX_BANKS], px_good[PX_PORTS], px_state[PX_PORTS];

void px_space() {
    while (px_pos &lt; px_len &amp;&amp; (px_json[px_pos]==' ' || px_json[px_pos]=='\r' || px_json[px_pos]=='\n' || px_json[px_pos]=='\t')) px_pos++;
}
int px_equal(int token, char *value) {
    int n;
    if (token &lt; 0 || token &gt;= px_count) return 0;
    n=px_end[token]-px_start[token];
    return n==strlen(value) &amp;&amp; strncmp(px_json+px_start[token],value,n)==0;
}
int px_same(int a, int b) {
    int n=px_end[a]-px_start[a];
    return n==px_end[b]-px_start[b] &amp;&amp; strncmp(px_json+px_start[a],px_json+px_start[b],n)==0;
}
int px_value(int depth) {
    int t, c, k, prior, v, digit;
    if (depth&gt;12 || px_count&gt;=PX_TOKENS) return -1;
    px_space();
    if (px_pos&gt;=px_len) return -1;
    t=px_count++;
    px_start[t]=px_pos;
    c=px_json[px_pos];
    if (c=='{' || c=='[') {
        px_type[t]=c; px_pos++; px_space();
        if (px_pos&lt;px_len &amp;&amp; px_json[px_pos]==(c=='{' ? '}' : ']')) px_pos++;
        else {
            while (1) {
                if (c=='{') {
                    k=px_value(depth+1);
                    if (k&lt;0 || px_type[k]!='&quot;') return -1;
                    prior=t+1;
                    while (prior&lt;k) {
                        if (px_same(prior,k)) return -1;
                        prior=px_next[prior+1];
                    }
                    px_space();
                    if (px_pos&gt;=px_len || px_json[px_pos++]!=':') return -1;
                }
                v=px_value(depth+1); if (v&lt;0) return -1;
                px_space(); if (px_pos&gt;=px_len) return -1;
                digit=px_json[px_pos++];
                if (digit==(c=='{' ? '}' : ']')) break;
                if (digit!=',') return -1;
            }
        }
    } else if (c=='&quot;') {
        px_type[t]='&quot;'; px_pos++; px_start[t]=px_pos;
        while (px_pos&lt;px_len &amp;&amp; px_json[px_pos]!='&quot;') {
            if ((unsigned char)px_json[px_pos]&lt;32 || px_json[px_pos]=='\\') return -1;
            px_pos++;
        }
        if (px_pos&gt;=px_len) return -1;
        px_end[t]=px_pos; px_pos++; px_next[t]=px_count; return t;
    } else if (c=='t' || c=='f' || c=='n') {
        px_type[t]=c;
        k=c=='t' ? 4 : (c=='f' ? 5 : 4);
        if (px_pos+k&gt;px_len || strncmp(px_json+px_pos,c=='t' ? &quot;true&quot; : (c=='f' ? &quot;false&quot; : &quot;null&quot;),k)!=0) return -1;
        px_pos+=k;
    } else {
        px_type[t]='N';
        if (px_json[px_pos]=='-') px_pos++;
        if (px_pos&gt;=px_len) return -1;
        if (px_json[px_pos]=='0') px_pos++;
        else {
            k=px_pos;
            while (px_pos&lt;px_len &amp;&amp; px_json[px_pos]&gt;='0' &amp;&amp; px_json[px_pos]&lt;='9') px_pos++;
            if (px_pos==k) return -1;
        }
        if (px_pos&lt;px_len &amp;&amp; px_json[px_pos]=='.') {
            px_pos++; k=px_pos;
            while (px_pos&lt;px_len &amp;&amp; px_json[px_pos]&gt;='0' &amp;&amp; px_json[px_pos]&lt;='9') px_pos++;
            if (px_pos==k) return -1;
        }
        if (px_pos&lt;px_len &amp;&amp; (px_json[px_pos]=='e' || px_json[px_pos]=='E')) {
            px_pos++;
            if (px_pos&lt;px_len &amp;&amp; (px_json[px_pos]=='+' || px_json[px_pos]=='-')) px_pos++;
            k=px_pos;
            while (px_pos&lt;px_len &amp;&amp; px_json[px_pos]&gt;='0' &amp;&amp; px_json[px_pos]&lt;='9') px_pos++;
            if (px_pos==k) return -1;
        }
    }
    px_end[t]=px_pos; px_next[t]=px_count; return t;
}
int px_parse(char *text) {
    px_json=text; px_pos=0; px_count=0; px_len=(int)strlen(text);
    if (px_len&lt;=0 || px_len&gt;=PX_BYTES || px_value(0)!=0) return 0;
    px_space(); return px_pos==px_len &amp;&amp; px_type[0]=='{';
}
int px_key(int object, char *key) {
    int i;
    if (object&lt;0 || object&gt;=px_count || px_type[object]!='{') return -1;
    i=object+1;
    while (i&lt;px_next[object]) {
        if (px_equal(i,key)) return i+1;
        i=px_next[i+1];
    }
    return -1;
}
int px_at(int array, int index) {
    int i;
    if (array&lt;0 || px_type[array]!='[') return -1;
    i=array+1;
    while (index&gt;0 &amp;&amp; i&lt;px_next[array]) { i=px_next[i]; index--; }
    return i&lt;px_next[array] ? i : -1;
}
int px_integer(int t, int maximum) {
    int p, v=0, digit;
    if (t&lt;0 || px_type[t]!='N') return -1;
    for (p=px_start[t];p&lt;px_end[t];p++) {
        digit=px_json[p]-'0';
        if (digit&lt;0 || digit&gt;9 || v&gt;(maximum-digit)/10 || digit&gt;maximum) return -1;
        v=v*10+digit;
    }
    return v;
}
int px_number(int t, float *value) {
    char number[40]; int n;
    if (t&lt;0 || px_type[t]!='N') return 0;
    n=px_end[t]-px_start[t]; if (n&lt;1 || n&gt;=40) return 0;
    memcpy(number,px_json+px_start[t],n); number[n]=0; *value=(float)atof(number);
    return *value==*value &amp;&amp; *value&gt;=-1.0e30 &amp;&amp; *value&lt;=1.0e30;
}
int px_reply(char *text, char *method, int ident) {
    int t;
    if (!px_parse(text)) return -1;
    if (!px_equal(px_key(0,&quot;resp&quot;),method) || px_integer(px_key(0,&quot;id&quot;),16000000)!=ident) return -1;
    t=px_key(0,&quot;error&quot;); if (t&gt;=0) return -1;
    t=px_key(0,&quot;result&quot;); return t&gt;=0 &amp;&amp; px_type[t]=='{' ? t : -1;
}
void px_clear() {
    int i;
    px_temp=0; px_temp_valid=0;
    for (i=0;i&lt;PX_BANKS;i++) { px_volts[i]=0; px_bank_valid[i]=0; }
    for (i=0;i&lt;PX_PORTS;i++) { px_good[i]=-1; px_state[i]=-1; }
}
int px_capabilities(char *text, int ident, char *mac) {
    int r, d, p, m, ports, banks;
    px_ports=0; px_banks=0; px_power=0; px_clear();
    r=px_reply(text,&quot;constantRead&quot;,ident);
    d=px_key(px_key(r,&quot;constant&quot;),&quot;dev&quot;);
    m=px_key(d,&quot;macAddr&quot;);
    if (d&lt;0 || m&lt;0 || px_type[m]!='&quot;' || strlen(mac)!=12 || !px_equal(m,mac)) return 0;
    ports=px_integer(px_key(d,&quot;pixPorts&quot;),PX_PORTS);
    banks=px_integer(px_key(d,&quot;pwrBanksIn&quot;),PX_BANKS);
    p=px_key(d,&quot;pwrOut&quot;);
    if (ports&lt;1 || banks&lt;0 || p&lt;0 || (px_type[p]!='t' &amp;&amp; px_type[p]!='f')) return 0;
    px_ports=ports; px_banks=banks; px_power=px_type[p]=='t'; return 1;
}
int px_statistics(char *text, int ident) {
    int r, s, d, a, p, i, t, value; float f;
    px_clear(); r=px_reply(text,&quot;statisticRead&quot;,ident);
    s=px_key(r,&quot;statistic&quot;); if (s&lt;0 || px_type[s]!='{') return 0;
    d=px_key(s,&quot;dev&quot;);
    if (px_number(px_key(px_key(d,&quot;temp&quot;),&quot;current&quot;),&amp;f)) { px_temp=f; px_temp_valid=1; }
    a=px_key(d,&quot;bankVolt&quot;);
    for (i=0;i&lt;px_banks;i++) {
        value=px_integer(px_at(a,i),2147483647);
        if (value&gt;=0) { px_volts[i]=(float)(value/1000.0); px_bank_valid[i]=1; }
    }
    p=px_key(s,&quot;pixPwrOuts&quot;);
    if (px_power) for (i=0;i&lt;px_ports;i++) {
        t=px_at(px_key(p,&quot;fuseGood&quot;),i);
        if (t&gt;=0 &amp;&amp; (px_type[t]=='t' || px_type[t]=='f')) px_good[i]=px_type[t]=='t';
        t=px_at(px_key(p,&quot;stat&quot;),i);
        if (t&gt;=0 &amp;&amp; px_type[t]=='&quot;') {
            if (px_equal(t,&quot;Good&quot;)) px_state[i]=0;
            if (px_equal(t,&quot;Inactv&quot;)) px_state[i]=1;
            if (px_equal(t,&quot;OvrCur&quot;)) px_state[i]=2;
            if (px_equal(t,&quot;FuseBlwn&quot;)) px_state[i]=3;
        }
    }
    return 1;
}








char px_file[80]=&quot;/user/pixlite-telemetry.json&quot;;
char px_buffer[PX_BYTES], px_message[512], px_mac[13], px_info[1024], px_fuses[2048], px_piece[96];
int px_ident=1, px_pending=0, px_phase=0, px_valid=0, px_enabled=0;
unsigned int px_sent=0, px_received=0, px_last=0, px_ttl=35;

int px_read_file() {
    FILE *f; int n, extra;
    f=fopen(px_file,&quot;r&quot;); if (!f) return 0;
    n=fread(px_buffer,1,PX_BYTES-1,f); extra=fgetc(f); fclose(f);
    if (n&lt;1 || n&gt;=PX_BYTES-1 || extra!=-1) return 0;
    px_buffer[n]=0;
    if (strlen(px_buffer)!=n) return 0;
    return px_parse(px_buffer);
}
void px_unavailable(char *why) {
    int i;
    px_valid=0; px_clear(); setoutput(0,0); setoutput(1,-9999); setoutput(2,0);
    for (i=0;i&lt;PX_BANKS;i++) setoutput(i+3,-9999);
    setoutput(11,0); setoutput(12,-1);
    setoutputtext(1,why); setoutputtext(2,&quot;Fuse status unavailable&quot;);
}
void px_publish() {
    int i, mask=0;
    setoutput(0,1); setoutput(1,px_temp_valid ? px_temp : -9999); setoutput(2,px_temp_valid);
    sprintf(px_info,&quot;Temperature: %s&quot;,px_temp_valid ? &quot;&quot; : &quot;unavailable&quot;);
    if (px_temp_valid) { sprintf(px_piece,&quot;%.2f C&quot;,px_temp); strcat(px_info,px_piece); }
    for (i=0;i&lt;PX_BANKS;i++) {
        setoutput(i+3,px_bank_valid[i] ? px_volts[i] : -9999);
        if (px_bank_valid[i]) mask=mask+(1&lt;&lt;i);
        if (i&lt;px_banks) {
            sprintf(px_piece,&quot;; Bank %d: &quot;,i+1); strcat(px_info,px_piece);
            if (px_bank_valid[i]) sprintf(px_piece,&quot;%.3f V&quot;,px_volts[i]);
            else strcpy(px_piece,&quot;unavailable&quot;);
            strcat(px_info,px_piece);
        }
    }
    setoutput(11,mask); setoutput(12,px_power ? px_ports : 0);
    if (!px_banks) strcat(px_info,&quot;; Bank voltage: unsupported&quot;);
    strcpy(px_fuses,px_power ? &quot;&quot; : &quot;Powered-output fuse telemetry: unsupported&quot;);
    if (px_power) for (i=0;i&lt;px_ports;i++) {
        sprintf(px_piece,&quot;%s%d:%s/&quot;,i ? &quot;; &quot; : &quot;Port &quot;,i+1,px_good[i]&lt;0 ? &quot;unknown&quot; : (px_good[i] ? &quot;fuse good&quot; : &quot;fuse not good&quot;));
        strcat(px_fuses,px_piece);
        if (px_state[i]==0) strcat(px_fuses,&quot;Good&quot;);
        else if (px_state[i]==1) strcat(px_fuses,&quot;Inactive&quot;);
        else if (px_state[i]==2) strcat(px_fuses,&quot;Overcurrent&quot;);
        else if (px_state[i]==3) strcat(px_fuses,&quot;Fuse blown&quot;);
        else strcat(px_fuses,&quot;unknown&quot;);
    }
    setoutputtext(1,px_info); setoutputtext(2,px_fuses);
}
int px_mac_input() {
    char *s; int i, ok=1;
    s=getinputtext(0);
    if (!s) return 0;
    if (strlen(s)!=12) ok=0;
    if (ok) for (i=0;i&lt;12;i++) if (!((s[i]&gt;='0' &amp;&amp; s[i]&lt;='9') || (s[i]&gt;='A' &amp;&amp; s[i]&lt;='F'))) ok=0;
    if (ok) { memcpy(px_mac,s,12); px_mac[12]=0; }
    free(s); return ok;
}
void px_send(int phase, unsigned int now) {
    int old=-1;
    if (px_read_file()) old=px_integer(px_key(0,&quot;id&quot;),16000000);
    px_ident++; if (px_ident&gt;16000000) px_ident=1;
    if (px_ident==old) { px_ident++; if (px_ident&gt;16000000) px_ident=1; }
    if (phase==1) sprintf(px_message,&quot;{\&quot;req\&quot;:\&quot;constantRead\&quot;,\&quot;id\&quot;:%d,\&quot;params\&quot;:{\&quot;path\&quot;:[\&quot;dev\&quot;]}}&quot;,px_ident);
    else sprintf(px_message,&quot;{\&quot;req\&quot;:\&quot;statisticRead\&quot;,\&quot;id\&quot;:%d,\&quot;params\&quot;:{\&quot;path\&quot;:[\&quot;dev.temp.current\&quot;,\&quot;dev.bankVolt\&quot;,\&quot;pixPwrOuts\&quot;]}}&quot;,px_ident);
    px_pending=1; px_phase=phase; px_sent=now;
    setoutputtext(0,px_message);
}

px_unavailable(&quot;Disabled. Commission MAC, reply path and HTTP output before enabling.&quot;);
while (1) {
    unsigned int now=getcurrenttime();
    float interval=getinput(1);
    int enabled=getinput(0)&gt;0;
    int result;
    if (!(interval&gt;=10 &amp;&amp; interval&lt;=300)) interval=30;
    if (!enabled) {
        if (px_enabled) px_unavailable(&quot;Disabled&quot;);
        px_enabled=0; px_pending=0; px_last=0;
    } else if (!px_enabled) {
        if (!px_mac_input()) px_unavailable(&quot;Commission a 12-digit uppercase MAC before enabling&quot;);
        else {
            px_ident=(now%4000000)*4;
            if (px_read_file()) {
                result=px_integer(px_key(0,&quot;id&quot;),16000000);
                if (result&gt;=0) px_ident=(result+32)%16000000;
            }
            px_enabled=1; px_unavailable(&quot;Waiting for fresh capabilities&quot;); px_send(1,now);
        }
    } else {
        if ((px_valid &amp;&amp; (now&lt;px_received || now-px_received&gt;px_ttl)) || (px_pending &amp;&amp; now&lt;px_sent)) {
            px_unavailable(&quot;Expired or clock changed&quot;); px_pending=0; px_last=now;
        }
        if (px_pending &amp;&amp; now&gt;=px_sent &amp;&amp; now-px_sent&gt;5) {
            px_unavailable(&quot;No fresh matching HTTP reply&quot;); px_pending=0; px_last=now;
        }
        if (px_pending &amp;&amp; px_read_file()) {
            result=px_integer(px_key(0,&quot;id&quot;),16000000);
            if (result==px_ident) {
                px_pending=0;
                if (px_phase==1) {
                    if (px_capabilities(px_buffer,px_ident,px_mac)) px_send(2,now);
                    else { px_unavailable(&quot;Capability reply rejected or identity changed&quot;); px_last=now; }
                } else if (px_statistics(px_buffer,px_ident)) {
                    px_valid=1; px_received=now; px_last=now; px_ttl=(unsigned int)interval+5; px_publish();
                } else { px_unavailable(&quot;Telemetry reply rejected&quot;); px_last=now; }
            }
        }
        if (!px_pending &amp;&amp; (px_last==0 || now&lt;px_last || now-px_last&gt;=interval)) {
            px_unavailable(&quot;Waiting for fresh telemetry&quot;); px_send(1,now);
        }
    }
    sleep(250);
}
